# App
APP_MODE=live          # "test" or "live" — set to "live" for production
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Security — generate a real random value, e.g. `openssl rand -hex 32`
# The app will refuse to start in live mode with the placeholder value.
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# Frontend URL — used for Stripe/Vipps redirect URLs after payment
FRONTEND_URL=https://vitalityboost.no

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vipps (apitest.vipps.no for testing, api.vipps.no for production)
VIPPS_BASE_URL=https://apitest.vipps.no
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=

# Accounting — configure whichever one(s) you use
TRIPLETEX_TOKEN=
FIKEN_API_KEY=

# Email
SENDGRID_API_KEY=
